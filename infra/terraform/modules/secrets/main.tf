# Key Vault holds every secret the app needs: DB credentials, JWT public key, and the column
# encryption keys (KEKs + blind-index key, ADR-0003). Purge protection: a deleted vault cannot
# be destroyed for 90 days - losing the KEKs would mean losing the encrypted data.
data "azurerm_client_config" "current" {}

resource "azurerm_key_vault" "this" {
  name                          = "kv-${var.name}"
  location                      = var.location
  resource_group_name           = var.resource_group_name
  tenant_id                     = data.azurerm_client_config.current.tenant_id
  sku_name                      = "premium" # HSM-backed keys available for a KMS-held KEK
  purge_protection_enabled      = true
  soft_delete_retention_days    = 90
  rbac_authorization_enabled    = true
  public_network_access_enabled = false
  tags                          = var.tags
}

# The KEKs and blind-index key themselves are NOT generated by Terraform: anything Terraform
# generates ends up in its state file. They are created once by a security officer (or via a
# Key Vault key with an HSM), then rotated by appending a version (CARESLOT_KEKS).
