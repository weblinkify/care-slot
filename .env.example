# Copy to .env (git-ignored). Values here are LOCAL-ONLY placeholders - never real secrets.
CARESLOT_ENVIRONMENT=local
CARESLOT_LOG_LEVEL=INFO

# Column-encryption keys (shared.crypto). `make env` / `make up` appends freshly generated
# random values; never commit them. In production they come from the secret store / KMS.
# CARESLOT_KEKS=v1:<base64 32 bytes>
# CARESLOT_BLIND_INDEX_KEY=<base64 32 bytes>
