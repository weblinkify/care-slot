# Architectural rules enforced in CI (`make lint`). See AGENTS.md section 2 and ADR-0001.
[importlinter]
root_package = careslot
include_external_packages = False

[importlinter:contract:shared-kernel-is-independent]
name = Shared kernel must not depend on any module
type = forbidden
source_modules = careslot.shared
forbidden_modules = careslot.modules

# Inside every module, dependencies point inwards: api -> infrastructure -> application -> domain.
# The domain therefore never imports FastAPI, SQLAlchemy or the use cases.
[importlinter:contract:module-layers]
name = Module layers point inwards
type = layers
containers =
    careslot.modules.scheduling
layers =
    api
    infrastructure
    application
    domain

# The mock IdP is a dev/demo adapter. Business modules must never depend on it.
[importlinter:contract:no-mock-idp-in-modules]
name = Modules do not depend on the mock identity provider
type = forbidden
source_modules = careslot.modules
forbidden_modules = careslot.mock_idp
